# Copy to terraform.tfvars (gitignored) and fill in real values.
#   cp terraform.tfvars.example terraform.tfvars

# Your home/office IP in CIDR form, for the debug ingress rule on the origin.
# Remove the var (and the dev-IP ingress block in ec2.tf) to lock the origin to
# Cloudflare edge IPs only.
dev_ip_cidr = "1.2.3.4/32"

# GitHub repo in <owner>/<repo> form — scopes the OIDC trust policy.
github_repo = "VijayBonthu/groundediq"

# FRESH production DB password — do NOT reuse the staging value.
# Generate: openssl rand -base64 24
db_password = "CHANGE_ME_generate_a_fresh_one"

# Where CloudWatch alarms (EC2 status, RDS storage/CPU) are emailed. You must
# click the confirmation link SNS sends after the first apply.
alarm_email = "you@example.com"
